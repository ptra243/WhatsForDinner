# Copy to .env.local to point the dev server at the local Supabase stack (`supabase start`).
# The key is the local stack's publishable key, printed by `npx supabase status --workdir ..`.
# Magic-link emails land in the local inbox (Mailpit) at http://127.0.0.1:54324.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
